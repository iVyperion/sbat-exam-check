# Copy this file to .env and fill in your values. .env is git-ignored.
# Place .env in the folder you start the app from, or next to the executable.

# (Not used by the checker itself — login happens via itsme)
SBAT_EMAIL=you@example.com
SBAT_PASSWORD=xxxx

# Telegram: create a bot via @BotFather, then get your chat id via @userinfobot
TELEGRAM_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=123456789

# Email (SMTP over SSL). Use single quotes if the password contains a $ sign.
EMAIL_SENDER=sender@example.com
EMAIL_PASSWORD='xxx$xxx'
EMAIL_RECEIVER=you@example.com

SMTP_SERVER=smtp.titan.email
SMTP_PORT=465

# Run the login browser invisibly (for a computer you can't see). The itsme QR
# code is then sent to Telegram and kept up to date until you've scanned it.
SBAT_HEADLESS=0
# Seconds to wait for an itsme login before giving up
SBAT_LOGIN_TIMEOUT=300
